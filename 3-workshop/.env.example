# OpenAI API Key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OneMap API token, from https://www.onemap.gov.sg/apidocs/register.
# Register account then obtain token.
ONEMAP_TOKEN=

# Debug Mode
# Set to "true" to see the ReAct thought process of agents
# Shows: Thoughts, Actions, Tool calls, Observations, and Orchestrator decisions
DEBUG=true
